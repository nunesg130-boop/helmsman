# Copy this file to .env beside compose.yaml, then edit only what you need.
# Media and infrastructure IPs, URLs, ports, and API credentials are configured
# in the interface. Proxmox token IDs and secrets never belong in this file.
# The reusable Helmsman access key is created or rotated in the application and
# never belongs in this file, Compose YAML, a URL, browser storage, or logs.
# Manual CIDRs are optional; the default mode approves only the exact safe private
# addresses resolved for each registered connection. None belong in this file.

# Set this to the lowercase GitHub Container Registry path published by the
# tagged workflow. GitHub release assets replace this source placeholder with
# the exact multi-architecture manifest digest automatically.
HELMSMAN_IMAGE=ghcr.io/OWNER/REPOSITORY:1.0.0-beta.2

# Safe same-machine default. Keep this on loopback for Docker Desktop or an SSH
# tunnel. Set an exact LAN address only when a trusted HTTPS edge needs to reach
# the container, then firewall the port to that edge.
HELMSMAN_BIND_IP=127.0.0.1
HELMSMAN_PORT=4180

# Upgrade only: when using deploy/compose.upgrade-v0.5.yaml, set this to the
# exact existing v0.5 volume name shown by `docker volume ls`. Fresh installs
# should leave this unset so Compose creates a project-scoped Helmsman volume.
# HELMSMAN_DATA_VOLUME=jellofin-command_jellofin-command-data
